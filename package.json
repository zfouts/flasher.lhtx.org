    "boards": "node scripts/sync-boards.mjs",
    "boards:latest": "node scripts/sync-boards.mjs --latest"
  },
  "devDependencies": {
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
