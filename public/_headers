/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Permissions-Policy: serial=(self), bluetooth=(self), geolocation=(), camera=(), microphone=()

# Font files never change under these names.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The page must never be older than the scripts it loads. index.html names the
# element ids that app.js looks up, so a stale copy paired with a fresh module
# means missing elements. Always revalidate it.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprint-free filenames, so keep these short-lived.
/js/*
  Cache-Control: public, max-age=300, must-revalidate
/css/*
  Cache-Control: public, max-age=300, must-revalidate
